{
  "stryker-config": {
    "project": "Directory.csproj",
    "test-projects": [
      "../Directory.Tests.Unit/Directory.Tests.Unit.csproj",
      "../Directory.Tests.Integration/Directory.Tests.Integration.csproj"
    ],
    "concurrency": 1,
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "mutation-level": "Advanced",
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "mutate": [
      "**/*Sql.cs"
    ],
    "since": {
      "enabled": false
    },
    "test-runner": "mtp",
    "coverage-analysis": "perTest"
  }
}
