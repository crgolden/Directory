{
  "stryker-config": {
    "project": "Directory.csproj",
    "test-projects": [
      "../Directory.Tests.Unit/Directory.Tests.Unit.csproj"
    ],
    "reporters": [
      "html",
      "json",
      "progress"
    ],
    "mutation-level": "Advanced",
    "thresholds": {
      "high": 100,
      "low": 100,
      "break": 100
    },
    "mutate": [
      "**/*.cs",
      "!obj/**/*.cs",
      "!Program.cs",
      "!**/*Endpoints.cs"
    ],
    "since": {
      "enabled": false
    },
    "test-runner": "mtp",
    "coverage-analysis": "perTest"
  }
}
