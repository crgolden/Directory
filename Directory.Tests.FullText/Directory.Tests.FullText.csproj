<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Directory.Tests.FullText</RootNamespace>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <OutputType>Exe</OutputType>
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
  	<Content Include="..\Directory.Tests.Integration\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
  	<Compile Include="..\Directory.Tests.Integration\TestSupport\DirectoryWebApplicationFactory.cs" Link="TestSupport\DirectoryWebApplicationFactory.cs" />
  	<Compile Include="..\Directory.Tests.Integration\TestSupport\IntegrationAuthHandler.cs" Link="TestSupport\IntegrationAuthHandler.cs" />
  	<Compile Include="..\Directory.Tests.Integration\TestSupport\TestDatabaseContract.cs" Link="TestSupport\TestDatabaseContract.cs" />
  	<Compile Include="..\Directory.Tests.Integration\TestSupport\TestDatabaseContractConstants.cs" Link="TestSupport\TestDatabaseContractConstants.cs" />
  </ItemGroup>

  <ItemGroup>
  	<None Include="..\.editorconfig" Link=".editorconfig" />
  </ItemGroup>

  <ItemGroup>
  	<Using Include="Shared.Testing" />
  	<Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Directory\Directory.csproj" />
  </ItemGroup>

  <ItemGroup>
  	<PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  	<PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
  	<PackageReference Include="Moq" Version="4.21.0" />
  	<PackageReference Include="Shared" Version="1.5.1" />
  	<PackageReference Include="SonarAnalyzer.CSharp" Version="10.35.0.4138">
  		<PrivateAssets>all</PrivateAssets>
  		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
  	</PackageReference>
  	<PackageReference Include="StyleCop.Analyzers" Version="1.2.0-beta.556">
  		<PrivateAssets>all</PrivateAssets>
  		<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
  	</PackageReference>
  	<PackageReference Include="xunit.v3.mtp-v2" Version="4.0.2" />
  </ItemGroup>

</Project>
